{
  "include": ["app/**/*", ".react-router/types/**/*", "*.ts"],
  "compilerOptions": {
    "target": "ES2022", "lib": ["DOM", "DOM.Iterable", "ES2022"], "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "strict": true, "skipLibCheck": false, "noEmit": true, "isolatedModules": true, "verbatimModuleSyntax": true,
    "types": ["node", "vite/client"], "rootDirs": [".", "./.react-router/types"]
  }
}
