{
  "name": "docs",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "gen": "node scripts/gen-props.ts && node scripts/gen-demos.ts && node scripts/gen-styling.ts && node scripts/gen-markdown.ts && node scripts/gen-size.ts && node scripts/gen-thumbs.ts",
    "predev": "npm run gen",
    "dev": "vite",
    "prebuild": "npm run gen",
    "build": "vite build && node scripts/prerender.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:docs": "node --test 'scripts/*.test.ts'"
  },
  "dependencies": {
    "@monoline/react": "*",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@monoline/css": "*",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  }
}
