{
  "$schema": "https://biomejs.dev/schemas/2.6.9/schema.json",
  // Formatter and linter for JS/TS only (ADR 0011). CSS has its own checks (npm run check -w @monoline/css);
  // JSON, Markdown and YAML stay hand-written. Generated files are excluded here or by .gitignore.
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx}",
      "!registry",
      "!packages/tokens/dist",
      "!packages/vscode/snippets"
    ]
  },
  // Matches the existing code: single quotes, semicolons, {a} without spaces, 120 columns (where comments wrap).
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "bracketSpacing": false,
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  // No import sorting: import order is meaningful (CSS side-effect imports) and hand-kept.
  "assist": { "enabled": false },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": {
        // noUncheckedIndexedAccess is on; AGENTS.md asks for `xs[0]!` where the index is known to exist.
        "noNonNullAssertion": "off",
        "useTemplate": "off"
      },
      "complexity": {
        "useLiteralKeys": "off",
        // `a && a.b` and `a?.b` differ when `a` is 0 or '': not a safe mechanical rewrite.
        "useOptionalChain": "off",
        // Math.min turns Dates into numbers and propagates NaN; the ternaries are deliberate.
        "useMathMinMax": "off",
        "noCommaOperator": "off"
      },
      "suspicious": {
        // tsc (strict) already checks these: evolving `let`, explicit any is a visible choice, type and value sharing a name.
        "noImplicitAnyLet": "off",
        "noExplicitAny": "off",
        "noRedeclare": "off",
        // House style: `while ((m = re.exec(s)))`, `(map[k] ??= []).push(v)`, expression-bodied forEach callbacks.
        "noAssignInExpressions": "off",
        "useIterableCallbackReturn": "off",
        // Every index-keyed list renders a fixed array that never reorders.
        "noArrayIndexKey": "off"
      },
      "a11y": {
        // These flag the WAI-ARIA APG composite-widget patterns the components implement on purpose: listbox and tree on
        // <ul>, grid on <table>, role=group/row/separator on <div>, focus kept on the input with aria-activedescendant,
        // role=list kept on styled lists for Safari, focusable scroll regions (axe's scrollable-region-focusable), and
        // controls passed to <label> through a variable. Behaviour is checked instead by axe in every component test,
        // the ax accessibility-tree run and the keyboard e2e suite.
        "useSemanticElements": "off",
        "noNoninteractiveElementToInteractiveRole": "off",
        "useFocusableInteractive": "off",
        "useKeyWithClickEvents": "off",
        "noStaticElementInteractions": "off",
        "noNoninteractiveTabindex": "off",
        "noRedundantRoles": "off",
        "noLabelWithoutControl": "off",
        "noAriaHiddenOnFocusable": "off"
      },
      "correctness": {
        // Effects that list a value only to re-run when it changes (route, open state) are intended.
        "useExhaustiveDependencies": { "level": "error", "options": { "reportUnnecessaryDependencies": false } }
      }
    }
  },
  "overrides": [
    {
      // Tests render bare <button>s outside forms and define small components inside test cases.
      "includes": ["**/*.test.tsx"],
      "linter": {
        "rules": { "a11y": { "useButtonType": "off" }, "correctness": { "noComponentHookFactories": "off" } }
      }
    },
    {
      // ES5 script for CSS-only users, loaded with a classic <script>: keeps function expressions, var and 'use strict'.
      "includes": ["packages/css/js/monoline.js"],
      "linter": {
        "rules": {
          "complexity": { "useArrowFunction": "off" },
          "correctness": { "noInnerDeclarations": "off" },
          "suspicious": { "noRedundantUseStrict": "off" }
        }
      }
    }
  ]
}
