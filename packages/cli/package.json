{
  "name": "monoline",
  "version": "0.5.0",
  "description": "Copy Monoline components into your project: monoline add button dialog.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "cli",
    "components",
    "copy",
    "shadcn",
    "design-system",
    "ui"
  ],
  "homepage": "https://monoline.prashantdasari.com/",
  "bugs": {
    "url": "https://github.com/dasariprashant0/monoline/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dasariprashant0/monoline.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "monoline": "bin/monoline.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p .",
    "prepack": "npm run build",
    "test": "tsc -p . && node --test"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
