{
  "name": "@monoline/mcp",
  "version": "0.5.0",
  "description": "Model Context Protocol server for Monoline: list, search and read components, install commands and the theming guide from any AI tool.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dasariprashant0/monoline.git",
    "directory": "packages/mcp"
  },
  "bin": {
    "monoline-mcp": "bin/monoline-mcp.mjs"
  },
  "files": [
    "bin",
    "dist",
    "theming.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p .",
    "prepack": "npm run build",
    "test": "tsc -p . && node --test"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
