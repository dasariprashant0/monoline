  "base": {
    "$extensions": {
      "monoline": {
        "file": "tokens.css",
        "selector": ":root"
      }
    },
    "code": {
      "keyword": {
        "$value": "#FF9A70",
        "$type": "color",
        "$description": "Code colours. The code panel is always dark (--surface), so these are one set for every theme. `npm run check` tests each against all three surfaces for 4.5:1."
      },
      "string": {
        "$value": "#A8E6A1",
        "$type": "color"
      },
      "number": {
        "$value": "#F5CD7A",
        "$type": "color"
      },
      "comment": {
        "$value": "#9A9EAD",
        "$type": "color"
      },
      "tag": {
        "$value": "#7FC8FF",
        "$type": "color"
      },
      "attr": {
        "$value": "#F0A8D4",
        "$type": "color"
      },
      "fn": {
        "$value": "#D6B4FF",
        "$type": "color"
      }
    },
    "type": {
      "font-display": {
        "$value": "\"Space Mono\", ui-monospace, monospace",
        "$description": "Type: Space Mono for display, DM Mono for everything else."
      },
      "font-body": {
        "$value": "\"DM Mono\", ui-monospace, monospace"
      },
      "text-xs": {
        "$value": "11px",
        "$type": "dimension"
      },
      "text-sm": {
        "$value": "13px",
        "$type": "dimension"
      },
      "text-base": {
        "$value": "15px",
        "$type": "dimension"
      },
      "text-lg": {
        "$value": "18px",
        "$type": "dimension"
      },
      "heading-1": {
        "$value": "clamp(32px, 4vw, 44px)",
        "$description": "Page headings in app content (Heading level 1 and 2, .prose h2). The 64px+ display sizes below are for heroes (.display-*)."
      },
      "heading-2": {
        "$value": "clamp(26px, 3vw, 34px)"
      },
      "display-sm": {
        "$value": "clamp(28px, 3.4vw, 40px)"
      },
      "display-md": {
        "$value": "clamp(34px, 5vw, 64px)"
      },
      "display-xl": {
        "$value": "clamp(44px, 8vw, 104px)"
      },
      "weight-regular": {
        "$value": "400",
        "$description": "Weights: the three the bundled fonts ship (400 and 700 Space Mono, 400 and 500 DM Mono). No 600 is used."
      },
      "weight-medium": {
        "$value": "500"
      },
      "weight-bold": {
        "$value": "700"
      },
      "leading-tight": {
        "$value": "1.2",
        "$description": "Line heights: tight for headings, normal for body text (the page default), relaxed for code and long form."
      },
      "leading-normal": {
        "$value": "1.55"
      },
      "leading-relaxed": {
        "$value": "1.6"
      }
    },
    "color": {
      "rule": {
        "$value": "color-mix(in srgb, {color.foreground} 20%, transparent)",
        "$type": "color",
        "$description": "Lines: a 20% mix of the text colour. --border alone is ~1.1:1 in the dark themes, so dividers use --rule."
      },
      "wash": {
        "$value": "color-mix(in srgb, {color.foreground} 4%, transparent)",
        "$type": "color",
        "$description": "Washes: hover rows, code blocks, selected cells."
      },
      "wash-2": {
        "$value": "color-mix(in srgb, {color.foreground} 9%, transparent)",
        "$type": "color"
      },
      "ink-1": {
        "$value": "{color.foreground}",
        "$type": "color",
        "$description": "Ink density: tell up to five kinds apart without new colours."
      },
      "ink-2": {
        "$value": "color-mix(in srgb, {color.foreground} 70%, transparent)",
        "$type": "color"
      },
      "ink-3": {
        "$value": "color-mix(in srgb, {color.foreground} 45%, transparent)",
        "$type": "color"
      },
      "ink-4": {
        "$value": "color-mix(in srgb, {color.foreground} 25%, transparent)",
        "$type": "color"
      },
      "ink-5": {
        "$value": "color-mix(in srgb, {color.foreground} 10%, transparent)",
        "$type": "color"
      },
      "hatch": {
        "$value": "repeating-linear-gradient(135deg, {color.muted} 0 1.5px, transparent 1.5px 7px)"
      }
    },
    "space": {
      "s1": {
        "$value": "4px",
        "$type": "dimension",
        "$description": "Space: 4px steps."
      },
      "s2": {
        "$value": "8px",
        "$type": "dimension"
      },
      "s3": {
        "$value": "12px",
        "$type": "dimension"
      },
      "s4": {
        "$value": "16px",
        "$type": "dimension"
      },
      "s5": {
        "$value": "24px",
        "$type": "dimension"
      },
      "s6": {
        "$value": "32px",
        "$type": "dimension"
      },
      "s7": {
        "$value": "48px",
        "$type": "dimension"
      },
      "s8": {
        "$value": "64px",
        "$type": "dimension"
      },
      "s9": {
        "$value": "96px",
        "$type": "dimension"
      }
    },
    "control": {
      "sm": {
        "$value": "calc({space.s6} + {space.s1})",
        "$description": "One height per size for every single-line control, so Button, Input, Select and friends line up in a form row."
      },
      "md": {
        "$value": "{space.s7}"
      },
      "lg": {
        "$value": "calc({space.s7} + {space.s2})"
      }
    },
    "radius": {
      "radius": {
        "$value": "0",
        "$description": "Shape: square. One radius for the rare round thing (a ring, a dot)."
      },
      "round": {
        "$value": "999px",
        "$type": "dimension"
      },
      "radius-sm": {
        "$value": "calc({radius.radius} * 0.5)",
        "$description": "Radius scale, derived from --radius so data-radius=\"soft\" | \"round\" moves every step: square 0/0/0, soft 3/6/9px, round 6/12/18px. --radius-md is --radius. Set data-radius on <html>: these are resolved there."
      },
      "radius-md": {
        "$value": "{radius.radius}"
      },
      "radius-lg": {
        "$value": "calc({radius.radius} * 1.5)"
      }
    },
    "effect": {
      "border-width": {
        "$value": "1px",
        "$type": "dimension",
        "$description": "Lines and states."
      },
      "opacity-disabled": {
        "$value": "0.5"
      },
      "focus-ring": {
        "$value": "2px solid {color.accent}",
        "$description": "Focus: the one ring. Add outline-offset where the control needs room (base.css uses 3px). Resolved on <html>, like the accent."
      },
      "shadow-popover": {
        "$value": "none",
        "$description": "Elevation. Popovers and menus are flat panels with a rule, so --shadow-popover is none (a hook for apps that want a lift). The toast floats over the page."
      },
      "shadow-toast": {
        "$value": "0 8px 30px -12px rgba(0, 0, 0, 0.5)"
      }
    },
    "motion": {
      "ease": {
        "$value": "cubic-bezier(0.76, 0, 0.24, 1)",
        "$description": "Motion."
      },
      "fast": {
        "$value": "0.12s"
      },
      "base": {
        "$value": "0.2s"
      },
      "slow": {
        "$value": "0.45s"
      }
    },
    "layout": {
      "side": {
        "$value": "264px",
        "$type": "dimension",
        "$description": "Layout. sidebar width"
      },
      "measure": {
        "$value": "64ch",
        "$description": "longest comfortable line"
      },
      "content": {
        "$value": "1080px",
        "$type": "dimension",
        "$description": "widest main column"
      },
      "container-sm": {
        "$value": "640px",
        "$type": "dimension",
        "$description": "Container widths (Tailwind's steps), for max-width on a centred column."
      },
      "container-md": {
        "$value": "768px",
        "$type": "dimension"
      },
      "container-lg": {
        "$value": "1024px",
        "$type": "dimension"
      },
      "container-xl": {
        "$value": "1280px",
        "$type": "dimension"
      },
      "container-2xl": {
        "$value": "1536px",
        "$type": "dimension"
      },
      "bp-xs": {
        "$value": "480px",
        "$type": "dimension",
        "$description": "Breakpoints, for JavaScript (matchMedia) and documentation. CSS cannot read a variable inside @media, so a stylesheet must write the number out; these are the values to write. The built-in stylesheets still use older widths, listed in CHANGELOG.md; do not copy them."
      },
      "bp-sm": {
        "$value": "640px",
        "$type": "dimension"
      },
      "bp-md": {
        "$value": "768px",
        "$type": "dimension"
      },
      "bp-lg": {
        "$value": "1024px",
        "$type": "dimension"
      },
      "bp-xl": {
        "$value": "1280px",
        "$type": "dimension"
      },
      "bp-2xl": {
        "$value": "1536px",
        "$type": "dimension"
      },
      "window-pad": {
        "$value": "{space.s6}",
        "$description": "a small window's inset from every edge (Settings, a panel)"
      }
    },
    "zIndex": {
      "drawer": {
        "$value": "40",
        "$description": "Layers."
      },
      "grain": {
        "$value": "50"
      },
      "toast": {
        "$value": "60"
      }
    }
  },
