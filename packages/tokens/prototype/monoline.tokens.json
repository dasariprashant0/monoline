  "$extensions": {
    "monoline": {
      "headers": {
        "tokens.css": "Monoline tokens: the one source of every colour, size and timing. Components never use a raw value; if a token is missing, add it here (DESIGN.md \"Adding a token\"). An app may override only the accent group (--accent, --accent-text, --accent-2) in its own brand.css, per theme. Everything else is shared.",
        "accents.css": "Monoline accent presets. Orange is the default and lives in tokens.css. Set one on <html data-accent=\"green\">. Each pair passes, in all three themes: --accent-text on --background >= 4.5:1, --accent on --background >= 3:1, --on-accent on --accent >= 4.5:1. Load this file after tokens.css.",
        "options.css": "Options: change the look without touching components. Set on <html>. data-font=\"mono\" (default) | \"sans\" | \"serif\" data-radius=\"square\" (default) | \"soft\" | \"round\" (also resets the --radius-sm/md/lg scale, so it works on any wrapper) data-density=\"compact\" | \"comfortable\" (default) | \"spacious\" Load after components. Fonts use system stacks, nothing extra to download."
      },
      "rules": {
        "options.css": [
          "[data-font=\"sans\"] .display, [data-font=\"serif\"] .display { text-transform: none; letter-spacing: -0.02em; line-height: 1.05; }",
          "/* Cards, dialogs, alerts, code blocks, empty states, segmented controls and kbd take --radius-md in their own stylesheets. Badges and tags are set here (round makes them pills); round buttons too. */",
          "[data-radius=\"soft\"] .badge, [data-radius=\"soft\"] .tag, [data-radius=\"round\"] .badge, [data-radius=\"round\"] .tag { border-radius: var(--radius); }",
          "[data-radius=\"round\"] .btn, [data-radius=\"round\"] .badge, [data-radius=\"round\"] .tag { border-radius: var(--round); }"
        ]
      }
    }
  }
