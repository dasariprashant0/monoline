{
  "$description": "PROTOTYPE (docs/decisions/0014-token-source-of-truth.md). Monoline tokens as DTCG JSON. Each top-level group is one CSS block (a token set); aliases such as {color.foreground} resolve within the merged sets for a theme and accent, not as absolute paths. Generate the CSS with to-css.ts. Not used by the build.",
  "warm": {
    "$description": "─── Theme: Warm (default, light) ───",
    "$extensions": {
      "monoline": {
        "file": "tokens.css",
        "selector": ":root, [data-theme=\"warm\"]",
        "css": {
          "color-scheme": "light"
        }
      }
    },
    "color": {
      "background": {
        "$value": "#FAFAF5",
        "$type": "color"
      },
      "foreground": {
        "$value": "#16120E",
        "$type": "color"
      },
      "muted": {
        "$value": "#706B65",
        "$type": "color",
        "$description": "4.9:1 on background"
      },
      "border": {
        "$value": "#E6E1D9",
        "$type": "color"
      },
      "surface": {
        "$value": "#16120E",
        "$type": "color",
        "$description": "always-dark panel: toasts, code"
      },
      "surface-text": {
        "$value": "rgba(250, 250, 245, 0.85)",
        "$type": "color"
      },
      "accent": {
        "$value": "#FF4500",
        "$type": "color",
        "$description": "fills, marks, focus; not body text"
      },
      "accent-text": {
        "$value": "#D13900",
        "$type": "color",
        "$description": "accent as text: 4.6:1 on background"
      },
      "accent-2": {
        "$value": "#AAFF00",
        "$type": "color"
      },
      "on-accent": {
        "$value": "#16120E",
        "$type": "color",
        "$description": "text on an accent fill: 5.6:1"
      },
      "danger": {
        "$value": "#B3261E",
        "$type": "color"
      },
      "warning": {
        "$value": "#8A5300",
        "$type": "color"
      },
      "ok": {
        "$value": "#1F6B3A",
        "$type": "color"
      }
    }
  },
