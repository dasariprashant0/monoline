    "deny": [
      "Bash(git push --force*)","Bash(git push -f*)","Bash(git push * --force*)","Bash(git push * -f*)","Bash(git push * --force-with-lease*)",
      "Bash(sudo*)",
      "Bash(rm -rf /)","Bash(rm -rf / *)","Bash(rm -rf /*)","Bash(rm -rf ~*)","Bash(rm -rf $HOME*)","Bash(rm -rf \"$HOME\"*)",
      "Bash(chmod -R 777*)",
      "Bash(curl * | sh*)","Bash(curl * | bash*)","Bash(curl * | zsh*)","Bash(wget * | sh*)","Bash(wget * | bash*)","Bash(wget * | zsh*)",
      "Edit(~/.ssh/**)","Edit(~/.aws/**)","Edit(~/.config/gh/**)","Edit(~/.netrc)","Edit(~/.npmrc)","Edit(~/.gnupg/**)",
      "Read(~/.ssh/**)","Read(~/.aws/**)","Read(~/.config/gh/**)","Read(~/.netrc)","Read(~/.npmrc)","Read(~/.gnupg/**)",
      "Bash(*~/.ssh*)","Bash(*~/.aws*)","Bash(*~/.config/gh*)","Bash(*.ssh/*)","Bash(*.aws/*)"
    ]
  }
}
