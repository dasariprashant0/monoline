      "Bash(curl * -X *)","Bash(curl * --request *)","Bash(curl * -d *)","Bash(curl * --data*)","Bash(curl * -F *)","Bash(curl * --form*)","Bash(curl * -T *)","Bash(curl * --upload-file*)",
      "Bash(rm)","Bash(rm *)","Bash(rmdir*)",
      "Bash(git reset*)","Bash(git clean*)","Bash(git checkout -- *)","Bash(git restore*)",
      "Bash(git branch -d*)","Bash(git branch -D*)","Bash(git branch -m*)","Bash(git branch -M*)","Bash(git branch --delete*)",
      "Bash(git tag -d*)","Bash(git tag --delete*)","Bash(git worktree remove*)","Bash(git worktree prune*)",
      "Bash(git stash drop*)","Bash(git stash clear*)","Bash(git gc*)","Bash(git prune*)","Bash(git reflog expire*)",
      "Bash(git rebase*)","Bash(git commit * --amend*)","Bash(git commit --amend*)","Bash(git filter-*)",
      "Bash(mv *)","Bash(truncate*)","Bash(dd *)","Bash(find * -delete*)","Bash(find * -exec rm*)",
      "Bash(*DROP *)","Bash(*TRUNCATE *)"
